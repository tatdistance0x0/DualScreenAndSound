<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_panel_card"
    android:orientation="vertical"
    android:padding="@dimen/dashboard_card_padding">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/dashboard_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/play_state_idle"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/file_not_selected"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/route_output_default"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:boxBackgroundColor="@color/white"
        app:boxBackgroundMode="filled"
        app:boxCornerRadiusBottomEnd="22dp"
        app:boxCornerRadiusBottomStart="22dp"
        app:boxCornerRadiusTopEnd="22dp"
        app:boxCornerRadiusTopStart="22dp"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:endIconMode="dropdown_menu"
        app:endIconTint="@color/text_muted"
        app:hintEnabled="false">

        <AutoCompleteTextView
            android:id="@+id/spinnerRouteDisplay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@null"
            android:completionThreshold="0"
            android:dropDownHeight="wrap_content"
            android:dropDownWidth="match_parent"
            android:ellipsize="end"
            android:inputType="none"
            android:maxLines="1"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:popupBackground="@color/surface_elevated"
            android:textColor="@color/spinner_text"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvAudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/route_audio_default"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:boxBackgroundColor="@color/white"
        app:boxBackgroundMode="filled"
        app:boxCornerRadiusBottomEnd="22dp"
        app:boxCornerRadiusBottomStart="22dp"
        app:boxCornerRadiusTopEnd="22dp"
        app:boxCornerRadiusTopStart="22dp"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:endIconMode="dropdown_menu"
        app:endIconTint="@color/text_muted"
        app:hintEnabled="false">

        <AutoCompleteTextView
            android:id="@+id/spinnerRouteAudio"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@null"
            android:completionThreshold="0"
            android:dropDownHeight="wrap_content"
            android:dropDownWidth="match_parent"
            android:ellipsize="end"
            android:inputType="none"
            android:maxLines="1"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:popupBackground="@color/surface_elevated"
            android:textColor="@color/spinner_text"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPlayPause"
            style="@style/DashboardActionButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:text="@string/action_play_pause"
            android:textColor="@color/button_primary_text" />

        <Space
            android:layout_width="@dimen/dashboard_card_gap"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnOpenFile"
            style="@style/DashboardActionButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_file"
            android:text="@string/action_open_file"
            android:textColor="@color/button_file_text" />

        <Space
            android:layout_width="@dimen/dashboard_card_gap"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnStop"
            style="@style/DashboardActionButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_danger"
            android:text="@string/action_stop"
            android:textColor="@color/button_danger_text" />
    </LinearLayout>
</LinearLayout>
