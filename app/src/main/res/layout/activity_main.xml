<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/controlsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/surface_elevated"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeColor="#C7D4EA"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Dual Screen Studio"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="双屏异显与音频路由演示控制台"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_status_main"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="● 主屏在线"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_status_sub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="● 副屏未连接"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_status_audio_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="● 音频设备 0"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/surface_elevated"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeColor="#C7D4EA"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="快速操作"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="先选文件与音频，再启动主/副屏播放"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_displaymanager"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_primary"
                        android:backgroundTint="@null"
                        android:fontFamily="sans-serif-medium"
                        android:minHeight="60dp"
                        android:text="主屏播放"
                        android:textAllCaps="false"
                        android:textColor="@color/button_primary_text"
                        android:textSize="18sp" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_presentation_displaymanager"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_primary"
                        android:backgroundTint="@null"
                        android:fontFamily="sans-serif-medium"
                        android:minHeight="60dp"
                        android:text="副屏播放"
                        android:textAllCaps="false"
                        android:textColor="@color/button_primary_text"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_selectfile"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_file"
                        android:backgroundTint="@null"
                        android:fontFamily="sans-serif-medium"
                        android:minHeight="60dp"
                        android:text="主屏文件"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_presentation_selectfile"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_file"
                        android:backgroundTint="@null"
                        android:fontFamily="sans-serif-medium"
                        android:minHeight="60dp"
                        android:text="副屏文件"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/surface_elevated"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeColor="#C7D4EA"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="路由设置"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="支持主屏、副屏与显示器目标切换"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_route_setting_item"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_route_badge_main"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="M"
                            android:textColor="#1F4F8D"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="主屏音频通道"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=">"
                            android:textColor="@color/text_muted"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="请选择"
                        app:boxBackgroundColor="@color/surface_soft"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/divider_soft"
                        app:endIconMode="dropdown_menu"
                        app:hintEnabled="false">

                        <AutoCompleteTextView
                            android:id="@+id/spinner_audio_devices"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:background="@null"
                            android:completionThreshold="0"
                            android:dropDownHeight="wrap_content"
                            android:dropDownWidth="match_parent"
                            android:ellipsize="end"
                            android:inputType="none"
                            android:maxLines="1"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:popupBackground="@color/surface_elevated"
                            android:textColor="@color/spinner_text"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tv_summary_main_audio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="当前：未选择"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_route_setting_item"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_route_badge_sub"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="S"
                            android:textColor="#1E6A4F"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="副屏音频通道"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=">"
                            android:textColor="@color/text_muted"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="请选择"
                        app:boxBackgroundColor="@color/surface_soft"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/divider_soft"
                        app:endIconMode="dropdown_menu"
                        app:hintEnabled="false">

                        <AutoCompleteTextView
                            android:id="@+id/spinner_audio_presentation_devices"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:background="@null"
                            android:completionThreshold="0"
                            android:dropDownHeight="wrap_content"
                            android:dropDownWidth="match_parent"
                            android:ellipsize="end"
                            android:inputType="none"
                            android:maxLines="1"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:popupBackground="@color/surface_elevated"
                            android:textColor="@color/spinner_text"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tv_summary_sub_audio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="当前：未选择"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_route_setting_item"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_route_badge_display"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="D"
                            android:textColor="#5D3C9D"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="目标副屏（0 为主屏）"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=">"
                            android:textColor="@color/text_muted"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="请选择"
                        app:boxBackgroundColor="@color/surface_soft"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/divider_soft"
                        app:endIconMode="dropdown_menu"
                        app:hintEnabled="false">

                        <AutoCompleteTextView
                            android:id="@+id/displaySpinner"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:background="@null"
                            android:completionThreshold="0"
                            android:dropDownHeight="wrap_content"
                            android:dropDownWidth="match_parent"
                            android:ellipsize="end"
                            android:inputType="none"
                            android:maxLines="1"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:popupBackground="@color/surface_elevated"
                            android:textColor="@color/spinner_text"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tv_summary_display"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="当前：未选择"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layout_sub_control_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/surface_elevated"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeColor="#C7D4EA"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                <LinearLayout
                    android:id="@+id/layout_sub_control_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="副屏增强控制"
                            android:textColor="@color/text_primary"
                            android:textSize="19sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="副屏播放后的进度、倍速与音量微调"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_sub_control_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="收起"
                        android:textColor="@color/brand_accent"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_sub_control_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="副屏进度与倍速"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_sub_current_time"
                            android:layout_width="54dp"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <SeekBar
                            android:id="@+id/seek_sub_progress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="1000" />

                        <TextView
                            android:id="@+id/tv_sub_total_time"
                            android:layout_width="54dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="00:00"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_sub_seek_back_10"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_secondary"
                            android:backgroundTint="@null"
                            android:minHeight="52dp"
                            android:text="-10s"
                            android:textAllCaps="false"
                            android:textColor="@color/button_secondary_text"
                            android:textSize="15sp" />

                        <Space
                            android:layout_width="8dp"
                            android:layout_height="1dp" />

                        <Button
                            android:id="@+id/btn_sub_seek_forward_10"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_secondary"
                            android:backgroundTint="@null"
                            android:minHeight="52dp"
                            android:text="+10s"
                            android:textAllCaps="false"
                            android:textColor="@color/button_secondary_text"
                            android:textSize="15sp" />

                        <Space
                            android:layout_width="8dp"
                            android:layout_height="1dp" />

                        <Button
                            android:id="@+id/btn_sub_speed"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_secondary"
                            android:backgroundTint="@null"
                            android:minHeight="52dp"
                            android:text="副屏 1.00x"
                            android:textAllCaps="false"
                            android:textColor="@color/button_secondary_text"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="副屏音量"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <SeekBar
                            android:id="@+id/seek_sub_volume"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="100" />

                    <TextView
                        android:id="@+id/tv_sub_volume_value"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="100%"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="主屏预览"
                android:textColor="@color/text_primary"
                android:textSize="19sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="右下角图标切换全屏，底部控制栏支持拖动与设置"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/surfaceContainer"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_surface_frame">

                <SurfaceView
                    android:id="@+id/surfaceView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:id="@+id/view_main_tap_layer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/layout_overlay_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_overlay_control_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">

                    <ImageButton
                        android:id="@+id/btn_overlay_play_pause"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_overlay_icon_button"
                        android:contentDescription="播放"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play_triangle"
                        android:tint="@color/white" />

                    <TextView
                        android:id="@+id/tv_overlay_current_time"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="00:00"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seek_overlay_progress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="1000" />

                    <TextView
                        android:id="@+id/tv_overlay_total_time"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:gravity="end"
                        android:text="00:00"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btn_overlay_speed_entry"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_overlay_icon_button"
                        android:backgroundTint="@null"
                        android:gravity="center"
                        android:minWidth="84dp"
                        android:minHeight="38dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="倍速"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <ImageButton
                        android:id="@+id/btn_overlay_volume_entry"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_overlay_icon_button"
                        android:contentDescription="音量设置"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_volume_simple"
                        android:tint="@color/white" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <ImageButton
                        android:id="@+id/btn_overlay_settings"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_overlay_icon_button"
                        android:contentDescription="播放器设置"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_settings_simple"
                        android:tint="@color/white" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <ImageButton
                        android:id="@+id/btn_fullscreen"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_overlay_icon_button"
                        android:contentDescription="进入全屏"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_fullscreen_enter"
                        android:tint="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_overlay_speed_panel"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="58dp"
                    android:background="@drawable/bg_overlay_setting_panel"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_overlay_speed_200"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:text="2.0x"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_overlay_speed_150"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:text="1.5x"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_overlay_speed_125"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:text="1.25x"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_overlay_speed_100"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:text="1.0x"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_overlay_speed_075"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:text="0.75x"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_overlay_speed_050"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:text="0.5x"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/layout_overlay_volume_panel"
                    android:layout_width="92dp"
                    android:layout_height="220dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="58dp"
                    android:background="@drawable/bg_overlay_setting_panel"
                    android:padding="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_overlay_volume_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="100"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/seek_overlay_volume"
                        android:layout_width="158dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/brand_accent"
                        android:progressBackgroundTint="#80FFFFFF"
                        android:thumbTint="@color/brand_accent"
                        android:rotation="-90" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/layout_overlay_setting_panel"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="58dp"
                    android:background="@drawable/bg_overlay_setting_panel"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="循环播放"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                        <Switch
                            android:id="@+id/switch_overlay_loop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="自动开播"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                        <Switch
                            android:id="@+id/switch_overlay_autoplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_center_play_state"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:alpha="0.96"
                    android:background="@drawable/bg_overlay_icon_button"
                    android:padding="12dp"
                    android:src="@drawable/ic_play_triangle"
                    android:tint="@color/white"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_hint_banner"
                android:paddingStart="12dp"
                android:paddingTop="9dp"
                android:paddingEnd="12dp"
                android:paddingBottom="9dp"
                android:text="提示：首次切换音频路由时可能有短暂静音，属于系统策略正常现象。"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

    <!-- 退出按钮 -->
    <Button
        android:id="@+id/btn_exit_fullscreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:text="退出全屏"
        android:visibility="gone" />

</RelativeLayout>
