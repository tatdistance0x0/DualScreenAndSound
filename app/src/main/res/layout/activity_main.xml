<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/controlsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <include
                android:id="@+id/headerDashboard"
                layout="@layout/layout_header_dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dashboard_section_spacing" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dashboard_section_spacing"
                android:orientation="horizontal">

                <include
                    android:id="@+id/mainScreenCard"
                    layout="@layout/layout_screen_control_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/subScreenCard"
                    layout="@layout/layout_screen_control_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_panel_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/tvPreviewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/preview_title"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvPreviewBindingInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/preview_binding_default"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/surfaceContainer"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_surface_frame"
                android:clipChildren="false"
                android:clipToPadding="false">

                <SurfaceView
                    android:id="@+id/surfaceView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:id="@+id/view_main_tap_layer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/layout_overlay_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_overlay_control_bar"
                    android:elevation="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <ImageButton
                        android:id="@+id/btn_overlay_play_pause"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_overlay_icon_button"
                        android:contentDescription="播放"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play_triangle"
                        android:tint="@color/overlay_text_primary" />

                    <TextView
                        android:id="@+id/tv_overlay_current_time"
                        android:layout_width="46dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="00:00"
                        android:textColor="@color/overlay_text_secondary"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seek_overlay_progress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progressTint="@color/brand_accent"
                        android:progressBackgroundTint="@color/overlay_track"
                        android:thumbTint="@color/overlay_text_primary" />

                    <TextView
                        android:id="@+id/tv_overlay_total_time"
                        android:layout_width="46dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:gravity="end"
                        android:text="00:00"
                        android:textColor="@color/overlay_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btn_overlay_speed_entry"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_overlay_icon_button"
                        android:backgroundTint="@null"
                        android:gravity="center"
                        android:minWidth="88dp"
                        android:minHeight="40dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="倍速"
                        android:textAllCaps="false"
                        android:textColor="@color/overlay_text_primary"
                        android:textSize="13sp" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <ImageButton
                        android:id="@+id/btn_overlay_volume_entry"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_overlay_icon_button"
                        android:contentDescription="音量设置"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_volume_simple"
                        android:tint="@color/overlay_text_primary" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <ImageButton
                        android:id="@+id/btn_overlay_settings"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_overlay_icon_button"
                        android:contentDescription="播放器设置"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_settings_simple"
                        android:tint="@color/overlay_text_primary" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <ImageButton
                        android:id="@+id/btn_fullscreen"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_overlay_icon_button"
                        android:contentDescription="进入全屏"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_fullscreen_enter"
                        android:tint="@color/overlay_text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_overlay_speed_panel"
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="78dp"
                    android:background="@drawable/bg_overlay_setting_panel"
                    android:elevation="8dp"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_overlay_speed_200"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="2.0x"
                        android:textColor="@color/overlay_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_overlay_speed_150"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="1.5x"
                        android:textColor="@color/overlay_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_overlay_speed_125"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="1.25x"
                        android:textColor="@color/overlay_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_overlay_speed_100"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="1.0x"
                        android:textColor="@color/overlay_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_overlay_speed_075"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="0.75x"
                        android:textColor="@color/overlay_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_overlay_speed_050"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="0.5x"
                        android:textColor="@color/overlay_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/layout_overlay_volume_panel"
                    android:layout_width="104dp"
                    android:layout_height="228dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="78dp"
                    android:background="@drawable/bg_overlay_setting_panel"
                    android:elevation="8dp"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_overlay_volume_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="100"
                        android:textColor="@color/overlay_text_primary"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/seek_overlay_volume"
                        android:layout_width="160dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/brand_accent"
                        android:progressBackgroundTint="@color/overlay_track"
                        android:rotation="-90"
                        android:thumbTint="@color/overlay_text_primary" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/layout_overlay_setting_panel"
                    android:layout_width="278dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="78dp"
                    android:background="@drawable/bg_overlay_setting_panel"
                    android:elevation="8dp"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="循环播放"
                            android:textColor="@color/overlay_text_primary"
                            android:textSize="15sp" />

                        <Switch
                            android:id="@+id/switch_overlay_loop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="自动开播"
                            android:textColor="@color/overlay_text_primary"
                            android:textSize="15sp" />

                        <Switch
                            android:id="@+id/switch_overlay_autoplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_center_play_state"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:alpha="0.96"
                    android:background="@drawable/bg_overlay_icon_button"
                    android:elevation="8dp"
                    android:padding="14dp"
                    android:src="@drawable/ic_play_triangle"
                    android:tint="@color/overlay_text_primary"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvDashboardTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dashboard_section_spacing"
                android:background="@drawable/bg_hint_banner"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:text="@string/dashboard_tip_default"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/advanced_settings_title"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/advanced_settings_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvAdvancedAudioDefault"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_chip_info"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:text="@string/advanced_default_audio"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvAdvancedDisplayDefault"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_chip_info"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:text="@string/advanced_default_display"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_chip_info"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:text="@string/advanced_debug_info"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnAdvancedReset"
                    style="@style/DashboardActionButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="@string/action_restore_default"
                    android:textColor="@color/button_secondary_text" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_exit_fullscreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:text="退出全屏"
        android:visibility="gone" />

</RelativeLayout>
