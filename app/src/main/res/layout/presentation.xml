<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_surface_frame"
    android:clipChildren="false"
    android:clipToPadding="false">

    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/view_presentation_tap_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/layout_presentation_overlay_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_overlay_control_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btn_presentation_overlay_play_pause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_overlay_icon_button"
            android:contentDescription="播放"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play_triangle"
            android:tint="@color/overlay_text_primary" />

        <TextView
            android:id="@+id/tv_presentation_current_time"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="00:00"
            android:textColor="@color/overlay_text_secondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seek_presentation_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1000"
            android:progressTint="@color/brand_accent"
            android:progressBackgroundTint="@color/overlay_track"
            android:thumbTint="@color/overlay_text_primary" />

        <TextView
            android:id="@+id/tv_presentation_total_time"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:gravity="end"
            android:text="00:00"
            android:textColor="@color/overlay_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_presentation_overlay_speed_entry"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_overlay_icon_button"
            android:backgroundTint="@null"
            android:gravity="center"
            android:minWidth="88dp"
            android:minHeight="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="倍速"
            android:textAllCaps="false"
            android:textColor="@color/overlay_text_primary"
            android:textSize="13sp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/btn_presentation_overlay_volume_entry"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_overlay_icon_button"
            android:contentDescription="副屏音量设置"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_volume_simple"
            android:tint="@color/overlay_text_primary" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/btn_presentation_overlay_settings"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_overlay_icon_button"
            android:contentDescription="副屏设置"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings_simple"
            android:tint="@color/overlay_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_presentation_overlay_speed_panel"
        android:layout_width="104dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="78dp"
        android:background="@drawable/bg_overlay_setting_panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_presentation_speed_200"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="2.0x"
            android:textColor="@color/overlay_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_presentation_speed_150"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="1.5x"
            android:textColor="@color/overlay_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_presentation_speed_125"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="1.25x"
            android:textColor="@color/overlay_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_presentation_speed_100"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="1.0x"
            android:textColor="@color/overlay_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_presentation_speed_075"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="0.75x"
            android:textColor="@color/overlay_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_presentation_speed_050"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="0.5x"
            android:textColor="@color/overlay_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/layout_presentation_overlay_volume_panel"
        android:layout_width="104dp"
        android:layout_height="228dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="78dp"
        android:background="@drawable/bg_overlay_setting_panel"
        android:elevation="8dp"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_presentation_volume_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="100"
            android:textColor="@color/overlay_text_primary"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seek_presentation_volume"
            android:layout_width="160dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:max="100"
            android:progress="100"
            android:progressTint="@color/brand_accent"
            android:progressBackgroundTint="@color/overlay_track"
            android:rotation="-90"
            android:thumbTint="@color/overlay_text_primary" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layout_presentation_overlay_setting_panel"
        android:layout_width="278dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="78dp"
        android:background="@drawable/bg_overlay_setting_panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="循环播放"
                android:textColor="@color/overlay_text_primary"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switch_presentation_overlay_loop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="自动开播"
                android:textColor="@color/overlay_text_primary"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switch_presentation_overlay_autoplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_presentation_center_play_state"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:alpha="0.96"
        android:background="@drawable/bg_overlay_icon_button"
        android:elevation="8dp"
        android:padding="14dp"
        android:src="@drawable/ic_play_triangle"
        android:tint="@color/overlay_text_primary"
        android:visibility="gone" />
</FrameLayout>
